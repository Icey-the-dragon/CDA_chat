# One-time builder for base/cda-kubeadm-base.vdi.
#
# This VM is NOT the lab: it is a generic Debian template with containerd,
# kubeadm, kubelet, kubectl, Guest Additions and the chat image already loaded.
# scripts/build-kubeadm-base.sh exports its disk and then destroys the VM.
#
#   bash scripts/build-kubeadm-base.sh
Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"
  config.vm.hostname = "cda-kubeadm-base"
  config.vm.define "cda-kubeadm-base"

  config.vm.provider "virtualbox" do |vb|
    vb.name = "cda-kubeadm-base"
    vb.memory = "2048"
    vb.cpus = 2
  end

  # The image is produced on the builder host by build-kubeadm-base.sh.
  config.vm.provision "file", source: "images/chat-server.tar",
    destination: "/home/vagrant/chat-server.tar"
  config.vm.provision "file", source: "kubernetes",
    destination: "/home/vagrant/cda-chat-kubernetes"

  config.vm.provision "shell", inline: <<-SHELL
    set -e
    export DEBIAN_FRONTEND=noninteractive

    echo "==> [base] swap off and kernel prerequisites..."
    swapoff -a
    sed -i '/\\bswap\\b/s/^/#/' /etc/fstab || true
    cat > /etc/modules-load.d/k8s.conf <<'EOF'
overlay
br_netfilter
EOF
    modprobe overlay
    modprobe br_netfilter
    cat > /etc/sysctl.d/k8s.conf <<'EOF'
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
EOF
    sysctl --system

    echo "==> [base] installing containerd, kubeadm, kubelet, kubectl..."
    apt-get update
    apt-get install -y ca-certificates curl gnupg kmod \
      apt-transport-https containerd virtualbox-guest-utils
    mkdir -p /etc/containerd
    containerd config default > /etc/containerd/config.toml
    sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
    systemctl enable --now containerd
    systemctl enable --now vboxservice

    K8S_MINOR="#{ENV.fetch('K8S_MINOR', '1.36')}"
    mkdir -p /etc/apt/keyrings
    curl -fsSL "https://pkgs.k8s.io/core:/stable:/v${K8S_MINOR}/deb/Release.key" \\
      | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
    echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v${K8S_MINOR}/deb/ /" \\
      > /etc/apt/sources.list.d/kubernetes.list
    apt-get update
    apt-get install -y kubelet kubeadm kubectl
    apt-mark hold kubelet kubeadm kubectl
    systemctl disable kubelet || true

    echo "==> [base] preloading the chat image into containerd..."
    ctr -n k8s.io images import /home/vagrant/chat-server.tar

    echo "==> [base] storing manifests (no network needed at boot)..."
    mkdir -p /opt/cda-chat/kubernetes
    cp -a /home/vagrant/cda-chat-kubernetes/. /opt/cda-chat/kubernetes/
    curl -fsSL https://github.com/flannel-io/flannel/releases/latest/download/kube-flannel.yml \\
      -o /opt/cda-chat/kubernetes/kube-flannel.yml
    curl -fsSL https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml \\
      -o /opt/cda-chat/kubernetes/metrics-server.yaml

    echo "==> [base] preloading every image (teacher PC needs no Internet)..."
    kubeadm config images pull || true
    {
      grep -h '^[[:space:]]*image:' /opt/cda-chat/kubernetes/*.yaml \\
        /opt/cda-chat/kubernetes/kubeadm/*.yaml \\
      | sed 's/^[[:space:]]*image:[[:space:]]*//; s/#.*//' \\
      | awk '{gsub(/[[:space:]]+$/, ""); if ($0 != "") print}'
    } | sort -u | while read -r img; do
      echo "    pulling $img"
      ctr -n k8s.io images pull "$img" || true
    done

    echo "==> [base] guestcontrol credentials..."
    echo 'vagrant:vagrant' | chpasswd
    grep -q '^vagrant ALL=(ALL) NOPASSWD:ALL' /etc/sudoers.d/vagrant \\
      || echo 'vagrant ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/vagrant
    chmod 440 /etc/sudoers.d/vagrant

    echo "==> [base] generalising (each lab VM gets its own identity)..."
    systemctl stop containerd vboxservice || true
    rm -f /etc/ssh/ssh_host_*
    rm -rf /etc/kubernetes /var/lib/kubelet /var/lib/kube-proxy
    truncate -s 0 /etc/machine-id
    rm -f /var/lib/dbus/machine-id
    sed -i '/^CDA_/d' /etc/environment || true
  SHELL
end
