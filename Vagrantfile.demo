# Single VM used to BUILD ova/demo.ova: Docker + k3d + the minimal bundle.
# The teacher imports the OVA with scripts/launch-ova.sh demo; Vagrant is not
# needed on that machine. No synced folder: `file` provisioner avoids rsync
# permission errors.
#
#   bash scripts/demo-ova-up.sh
#   bash scripts/export-ova.sh demo
Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"
  config.vm.hostname = "cda-demo-vm"

  # Useful while testing the VM before export. The OVA launcher recreates its
  # own NAT rule with the same guest port.
  config.vm.network "forwarded_port", guest: 8080, host: 8080

  config.vm.provider "virtualbox" do |vb|
    vb.name = "cda-demo-vm"
    vb.memory = "3072"
    vb.cpus = 2
  end

  config.vm.provision "file", source: "demo-bundle",
    destination: "/home/vagrant/demo-bundle"

  config.vm.provision "shell", inline: <<-SHELL
    set -e
    export DEBIAN_FRONTEND=noninteractive

    echo "==> [demo] Installing Docker, curl and kubectl..."
    apt-get update
    apt-get install -y ca-certificates curl docker.io
    systemctl enable --now docker

    ARCH="$(dpkg --print-architecture)"
    curl -fsSL "https://dl.k8s.io/release/v1.31.5/bin/linux/${ARCH}/kubectl" \
      -o /usr/local/bin/kubectl
    chmod +x /usr/local/bin/kubectl

    echo "==> [demo] Installing k3d..."
    curl -fsSL "https://github.com/k3d-io/k3d/releases/download/v5.7.4/k3d-linux-${ARCH}" \
      -o /usr/local/bin/k3d
    chmod +x /usr/local/bin/k3d

    echo "==> [demo] Installing the bundle into /opt/demo-bundle..."
    mkdir -p /opt/demo-bundle/images
    cp -a /home/vagrant/demo-bundle/. /opt/demo-bundle/
    cd /opt/demo-bundle

    # Preload every image so the imported OVA starts without a registry.
    docker pull node:22-alpine
    docker build -t cda-demo:latest app
    docker save -o images/cda-demo.tar cda-demo:latest

    K3S_IMAGE="rancher/k3s:v1.31.5-k3s1"
    docker pull "$K3S_IMAGE"
    docker save -o images/k3s.tar "$K3S_IMAGE"
    printf '%s\\n' "$K3S_IMAGE" > images/k3s-image.txt

    cat > /etc/systemd/system/cda-demo.service <<'UNIT'
[Unit]
Description=CDA demo k3d cluster (1 server + 2 agents)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/demo-bundle
ExecStart=/bin/bash -lc '/opt/demo-bundle/start.sh'
ExecStop=/bin/bash -lc '/opt/demo-bundle/teardown.sh'
TimeoutStartSec=600
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
UNIT

    systemctl daemon-reload
    systemctl enable cda-demo.service
    systemctl start cda-demo.service

    install -d -o vagrant -g vagrant /home/vagrant/.kube
    if [ -f /root/.kube/config ]; then
      cp /root/.kube/config /home/vagrant/.kube/config
      chown vagrant:vagrant /home/vagrant/.kube/config
    fi

    echo "==> [demo] Waiting for http://127.0.0.1:8080/healthz ..."
    for i in $(seq 1 90); do
      if curl -fsS --max-time 2 http://127.0.0.1:8080/healthz >/dev/null; then
        echo "==> [demo] Ready."
        exit 0
      fi
      sleep 5
    done
    echo "ERROR: demo app did not become ready during provisioning." >&2
    kubectl get nodes -o wide >&2 || true
    kubectl get pods -o wide >&2 || true
    exit 1
  SHELL
end
