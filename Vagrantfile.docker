# -*- mode: ruby -*-
# vi: set ft=ruby :

# Alternative Vagrant setup using Docker as the provider instead of VirtualBox.
# This runs the lab "nodes" as Docker containers managed by Vagrant and attempts
# to provision a k3s cluster inside them.
#
# IMPORTANT / limitations:
# - This is an experimental alternative to the VirtualBox Vagrantfile. Running
#   k3s inside Docker containers requires privileged containers and cgroup/system
#   support; behavior may vary by host/OS (Linux works best; Docker Desktop on
#   Windows/macOS/WSL2 can be finicky).
# - You must create the Docker network once before `vagrant up`:
#     docker network create cda-vagrant
# - Synced folders use bind mounts (host project dir -> /vagrant). On Windows,
#   run from a path Docker can mount and prefer Git Bash/WSL for `vagrant` if
#   paths are problematic.
# - The chat image is NOT auto-built/imported here. Build it and place it at
#   ./images/chat-server.tar (or import into the chat container) so the chat pod
#   can start. See README for image build steps.
# - For a simpler Docker-based Kubernetes workflow, prefer the k3d setup
#   (k3d-cluster.yaml + scripts/k3d-up.sh) documented in the README.
#
# Usage:
#   docker network create cda-vagrant   # once
#   vagrant --vagrantfile=Vagrantfile.docker up --provider=docker

Vagrant.configure("2") do |config|
  K3S_TOKEN = "supah-secret-:3"
  DOCKER_NETWORK = "cda-vagrant"

  config.ssh.username = "root"
  config.ssh.password = "vagrant"
  config.ssh.insert_key = false

  # Disable Vagrant-managed synced folders; we bind-mount /vagrant via Docker.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # Common Docker provider settings for all "VM" nodes.
  config.vm.provider "docker" do |d|
    d.build_dir = "docker/vagrant-node"
    d.remains_running = true
    d.has_ssh = true
    d.privileged = true
    d.create_args = [
      "--cgroupns=host",
      "-v", "/sys/fs/cgroup:/sys/fs/cgroup:rw",
      "--tmpfs", "/run",
      "--tmpfs", "/run/lock",
      "--tmpfs", "/tmp",
      "--network", DOCKER_NETWORK,
    ]
    # Bind-mount the project so manifests and images are visible at /vagrant.
    d.volumes = ["#{Dir.pwd}:/vagrant"]
  end

  nodes = {
    "k3s-worker-grafana" => { role: "grafana" },
    "k3s-worker-db"      => { role: "db" },
    "k3s-worker-chat"    => { role: "chat" },
    "k3s-worker-nginx"   => { role: "nginx", host_port: 8080, container_port: 30080 },
  }

  # Master / control-plane node
  config.vm.define "k3s-master" do |master|
    master.vm.hostname = "k3s-master"
    master.vm.provider "docker" do |d|
      d.name = "k3s-master"
    end

    master.vm.provision "shell", inline: <<-SHELL
      set -e
      MASTER_IP="$(hostname -i | awk '{print $1}')"
      echo "Installing K3s server on ${MASTER_IP}..."
      curl -sfL https://get.k3s.io | K3S_TOKEN="#{K3S_TOKEN}" sh -s - server --cluster-init \
        --node-ip "${MASTER_IP}" \
        --advertise-address "${MASTER_IP}" \
        --tls-san k3s-master \
        --tls-san "${MASTER_IP}" \
        --node-name k3s-master \
        --node-label role=control-plane \
        --node-label control-plane= \
        --flannel-iface eth0

      echo "Waiting for K3s API to become ready..."
      for attempt in $(seq 1 120); do
        if sudo k3s kubectl get nodes >/dev/null 2>&1; then
          echo "K3s API is ready."
          break
        fi
        sleep 2
      done

      if ! sudo k3s kubectl get nodes >/dev/null 2>&1; then
        echo "K3s did not become ready; recent service logs:"
        sudo journalctl -u k3s -b --no-pager -n 150 || true
        exit 1
      fi

      echo "Copying kubeconfig to /vagrant (server address may need adjustment for host use)..."
      sudo cp /etc/rancher/k3s/k3s.yaml /vagrant/kubeconfig.yaml 2>/dev/null || true
      sudo chmod 644 /vagrant/kubeconfig.yaml 2>/dev/null || true

      sudo k3s kubectl label node k3s-master \
        role=control-plane \
        node-role.kubernetes.io/control-plane= \
        --overwrite 2>/dev/null || true

      echo "Applying manifests..."
      if [ -d "/vagrant/kubernetes" ]; then
        sudo k3s kubectl apply -f /vagrant/kubernetes/
        sudo k3s kubectl rollout restart deployment/nginx-router 2>/dev/null || true
      else
        echo "Manifests folder not found!"
      fi
    SHELL
  end

  # Worker/agent nodes
  nodes.each do |name, info|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.provider "docker" do |d|
        d.name = name
        if info[:host_port] && info[:container_port]
          d.ports = ["#{info[:host_port]}:#{info[:container_port]}"]
        end
      end

      node.vm.provision "shell", inline: <<-SHELL
        set -e
        NODE_IP="$(hostname -i | awk '{print $1}')"

        if [ "#{info[:role]}" = "chat" ]; then
          if [ -f /vagrant/images/chat-server.tar ]; then
            echo "Preloading chat-server image from /vagrant/images/chat-server.tar..."
            sudo mkdir -p /var/lib/rancher/k3s/agent/images
            sudo cp /vagrant/images/chat-server.tar /var/lib/rancher/k3s/agent/images/chat-server.tar
          else
            echo "WARNING: /vagrant/images/chat-server.tar not found; the chat pod may stay in ErrImagePull."
          fi
        fi

        echo "Waiting for K3s master API..."
        until curl -k -s https://k3s-master:6443/cacerts > /dev/null; do
          sleep 3
        done

        echo "Joining cluster and applying role=#{info[:role]}..."
        curl -sfL https://get.k3s.io | K3S_URL="https://k3s-master:6443" K3S_TOKEN="#{K3S_TOKEN}" sh -s - agent \
          --node-ip "${NODE_IP}" \
          --node-name #{name} \
          --node-label role=#{info[:role]} \
          --flannel-iface eth0

        if [ "#{info[:role]}" = "chat" ] && [ -f /vagrant/images/chat-server.tar ] && systemctl is-active --quiet k3s-agent; then
          for attempt in 1 2 3 4 5; do
            sudo k3s ctr images import /vagrant/images/chat-server.tar && break
            sleep 3
          done
        fi
      SHELL
    end
  end
end
