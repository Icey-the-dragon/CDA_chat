# kubeadm lab using Vagrant's Docker provider on an ISOLATED user-defined network.
#
# The 5 nodes get static IPs in 172.28.0.0/16 and are NOT attached to Docker's
# default bridge, so they behave like real machines on their own LAN.
#
# Vagrant's Docker provider normally reads NetworkSettings.IPAddress to find
# SSH, but that field is empty on custom networks. Two things make it work:
#   1. each node publishes 22 on 127.0.0.1 only, so the provider has ssh_info;
#   2. config.ssh.host/port override that with the node's static LAN IP.
# The controller container also lives on the LAN (172.28.0.2) and reaches the
# nodes directly; no host port is needed for SSH.
#
# Usage:
#   bash scripts/kubeadm-up-docker.sh
#   KUBEADM_DOCKER=1 bash scripts/kubeadm-verify.sh
#   bash scripts/kubeadm-down-docker.sh
Vagrant.configure("2") do |config|
  NETWORK = "cda-kubeadm"

  config.ssh.username = "root"
  config.ssh.password = "vagrant"
  config.ssh.insert_key = false

  # Vagrant adds a default 127.0.0.1:2222 -> 22 mapping when has_ssh is true.
  # Disable it: our per-node loopback publish below is enough for ssh_info.
  config.vm.network "forwarded_port", id: "ssh", guest: 22, host: 2222, disabled: true

  # The repo is bind-mounted from the real host path (NODE_VOLUME_SOURCE).
  config.vm.synced_folder ".", "/vagrant", disabled: true

  base_create_args = [
    "--cgroupns=host",
    "-v", "/sys/fs/cgroup:/sys/fs/cgroup:rw",
    "--tmpfs", "/run:exec,mode=755",
    "--tmpfs", "/run/lock:exec,mode=1777",
    "--tmpfs", "/tmp:exec,mode=1777",
    "--network", NETWORK,
  ]

  config.vm.provider "docker" do |d|
    # Built by scripts/kubeadm-up-docker.sh so K8S_MINOR is a build arg.
    d.image = ENV.fetch("KUBEADM_NODE_IMAGE", "cda-kubeadm-node")
    d.remains_running = true
    d.has_ssh = true
    d.privileged = true
  end

  # ------------------------------------------------------------------ master
  config.vm.define "kubeadm-docker-controlplane" do |cp|
    cp.vm.hostname = "kubeadm-docker-controlplane"
    cp.ssh.host = "172.28.0.10"
    cp.ssh.port = 22
    cp.vm.provider "docker" do |d|
      d.name = "kubeadm-docker-controlplane"
      d.create_args = base_create_args + [
        "--ip", "172.28.0.10",
        "-p", "127.0.0.1:2201:22",
      ]
    end
    cp.vm.provision "shell", upload_path: "/root/kubeadm-provision.sh", inline: <<-SHELL
      set -e
      IP="$(hostname -i | awk '{print $1}')"

      if [ ! -f /etc/kubernetes/admin.conf ]; then
        echo "==> [kubeadm/docker] Running kubeadm init on ${IP}..."
        kubeadm init \\
          --apiserver-advertise-address="${IP}" \\
          --pod-network-cidr=10.244.0.0/16 \\
          --ignore-preflight-errors=Swap
      else
        echo "==> [kubeadm/docker] Control plane already initialized; skipping init."
      fi

      mkdir -p /root/.kube
      cp -f /etc/kubernetes/admin.conf /root/.kube/config

      echo "==> [kubeadm/docker] Installing Flannel CNI..."
      kubectl apply -f https://github.com/flannel-io/flannel/releases/latest/download/kube-flannel.yml
    SHELL
  end

  # ----------------------------------------------------------------- workers
  nodes = {
    "kubeadm-docker-worker-grafana" => { ip: "172.28.0.11", ssh: 2202, role: "grafana" },
    "kubeadm-docker-worker-db"      => { ip: "172.28.0.12", ssh: 2203, role: "db" },
    "kubeadm-docker-worker-chat"    => { ip: "172.28.0.13", ssh: 2204, role: "chat",
                                         chat_image: true },
    "kubeadm-docker-worker-nginx"   => { ip: "172.28.0.14", ssh: 2205, role: "nginx",
                                         chat_image: true,
                                         host_port: 18080, container_port: 30080 },
  }

  nodes.each do |name, info|
    worker_provision = <<-SHELL
      set -e

      if [ ! -f /etc/kubernetes/kubelet.conf ]; then
        if [ ! -f /vagrant/.kubeadm/join.sh ]; then
          echo "ERROR: /vagrant/.kubeadm/join.sh is missing. Run scripts/kubeadm-up-docker.sh first." >&2
          exit 1
        fi
        echo "==> [kubeadm/docker] Joining control plane..."
        bash /vagrant/.kubeadm/join.sh
      else
        echo "==> [kubeadm/docker] Node already joined; skipping join."
      fi

      if [ "#{info.fetch(:chat_image, false)}" = "true" ] && [ -f /vagrant/images/chat-server.tar ]; then
        echo "==> [kubeadm/docker] Importing chat-server image into containerd..."
        ctr -n k8s.io images import /vagrant/images/chat-server.tar
      fi
    SHELL

    config.vm.define name do |node|
      node.vm.hostname = name
      node.ssh.host = info[:ip]
      node.ssh.port = 22
      node.vm.provider "docker" do |d|
        d.name = name
        args = base_create_args + ["--ip", info[:ip], "-p", "127.0.0.1:#{info[:ssh]}:22"]
        if info[:host_port] && info[:container_port]
          d.ports = ["#{info[:host_port]}:#{info[:container_port]}"]
        end
        d.create_args = args
      end
      node.vm.provision "shell", upload_path: "/root/kubeadm-provision.sh", inline: worker_provision
    end
  end
end
