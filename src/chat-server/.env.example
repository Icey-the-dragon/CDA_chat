# HTTP port served by the chat server.
PORT=8080

# Internal Prometheus metrics port. Not exposed by the Kubernetes Service.
METRICS_PORT=9091

# NATS event bus shared by every chat replica.
NATS_URL=nats://127.0.0.1:4222
NATS_RECONNECT_MS=2000
PRESENCE_TTL_MS=30000

# MariaDB connection. In Kubernetes these are provided by the manifests.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chatapp
DB_USER=chat
DB_PASSWORD=chatpassword

# Optional tuning.
DB_POOL_SIZE=10
DB_RETRY_MS=3000
HISTORY_LIMIT=50
MAX_MESSAGE_LENGTH=2000
MAX_USERNAME_LENGTH=32
MAX_ROOM_LENGTH=64
